# REQUIRED. One of: dev | ci | demo | production. A missing or unknown value stops the server at startup.
# Only "dev" returns OTP codes in responses and loads this file; "production" uses the real outbound gateway,
# disables the mock bank route and demands strong secrets.
APP_ENV=dev
HTTP_PORT=8080
DATABASE_URL=postgres://HPay:HPay@localhost:5432/HPay?sslmode=disable
REDIS_ADDR=localhost:6379
# Placeholder for local dev only. Outside dev and ci the server refuses this exact value and anything under 32 bytes.
# Generate a real one with:  openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-32-bytes-min!!
# Shared secret for /internal/mock-bank/callback. Optional in dev/ci (a dev default is used); REQUIRED and
# non-default in demo. The route is not mounted in production.
# MOCK_BANK_SECRET=
# Comma separated proxy addresses/CIDRs whose X-Forwarded-For is trusted (empty = trust none).
# TRUSTED_PROXIES=
KYC_STORAGE_DIR=./data/kyc

# Storage configuration: local (default) | cloudinary
STORAGE_PROVIDER=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# TOTP second factor (ADR-0017). REQUIRED outside dev and ci: base64 of 32 random bytes. Generate with:  openssl rand -base64 32
# Losing this key makes every stored authenticator secret unreadable (users must re-enrol through support).
# TOTP_ENCRYPTION_KEY=

# PIN pepper (ADR-0018). REQUIRED outside dev and ci: base64 of 32 random bytes. Generate with:  openssl rand -base64 32
# It is mixed into every transaction PIN hash. Keep it OUT of the database, out of database backups and, where possible,
# out of the file that holds DATABASE_URL. Losing it forces a PIN reset for every user (docs/runbooks/pin-pepper.md).
# PIN_PEPPER=
# Name of the current pepper, stored inside each new hash. Pattern [a-z0-9-]{1,16}. Default p1. Change it with the key.
# PIN_PEPPER_ID=p1
# Retired peppers that may still verify while hashes use them, "id:base64,id2:base64". Remove an entry when the count
# query in the runbook shows no hash left under it.
# PIN_PEPPER_OLD=

# One-time code and notice delivery (ADR-0016, ADR-0017). Empty = log-only outside production and refusing in
# production and demo. Set to twilio and fill the four values below to send real SMS.
# SENDER_PROVIDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# TWILIO_FROM=

# OfferGuard limits are on by default. false switches off EVERY offer limit; the server refuses to start with it when APP_ENV is production or demo (dev and ci only).
# OFFERGUARD_ENABLED=true
